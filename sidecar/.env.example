# Copy to .env and set NC_TOWER_SIDECAR_TOKEN (host-root equivalent — keep mode 0600).
NC_TOWER_SIDECAR_TOKEN=

# Optional overrides (generic compose):
# NC_TOWER_DISK_PATHS=/
# NC_TOWER_COMPOSE_DIRS=
# NC_TOWER_SERVICE_TARGETS=portainer=https://example:9443,webmin=https://example:10000
# NC_TOWER_OPS_HOST_PATH=/var/lib/nc-tower/ops
# NC_TOWER_HOST_JOBS_DIR=/var/lib/nc-tower/ops/jobs
# NC_TOWER_NETWORK=cloud_cloud_network
